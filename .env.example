# ── MCA Timetable Intelligent Assistant — Environment Variables ──
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real credentials.

# Databricks workspace URL (e.g. https://dbc-xxxxx.cloud.databricks.com)
DATABRICKS_HOST=

# Databricks personal access token or OAuth token
DATABRICKS_TOKEN=

# SQL warehouse ID for timetable queries (find in Databricks SQL > Warehouses)
DATABRICKS_WAREHOUSE_ID=

# LLM serving endpoint name (default: databricks-gpt-oss-120b)
LLM_ENDPOINT=databricks-gpt-oss-120b

# Timetable table location
TIMETABLE_CATALOG=workspace
TIMETABLE_SCHEMA=default
TIMETABLE_TABLE=mca_timetable
